{
  "name": "sac-mcp-sidecar",
  "version": "0.1.0",
  "description": "SAC Local MCP Server Sidecar — SVIL Archive Core",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "rebuild:native": "npm rebuild better-sqlite3",
    "verify:native": "node --import tsx --test test/native_binding.test.ts",
    "test": "npm run build && npm run verify:native && node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.20.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
